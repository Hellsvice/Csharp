<Window x:Class="Hazi5WPF_CRUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hazi5WPF_CRUD"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <local:NullToBooleanConverter x:Key="NullToBooleanConverter" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Adatok megjelenítése -->
        <DataGrid ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Gombok CRUD műveletekhez -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" Margin="5">
            <Button Content="Add" Command="{Binding AddCommand}" Width="100" Margin="5" />
            <Button Content="Update" Command="{Binding UpdateCommand}" Width="100" Margin="5" IsEnabled="{Binding SelectedPerson, Converter={StaticResource NullToBooleanConverter}}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Width="100" Margin="5" IsEnabled="{Binding SelectedPerson, Converter={StaticResource NullToBooleanConverter}}" />
        </StackPanel>
    </Grid>
</Window>
