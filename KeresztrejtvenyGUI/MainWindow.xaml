<Window x:Class="KeresztrejtvenyGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeresztrejtvenyGUI"
        mc:Ignorable="d"
        Title="Keresztrejtvény készítő" Height="590" Width="727">

    <Canvas x:Name="KeresztrejtvenyCanvas">
        <Label Content="Keresztrejtvény méret [sor x oszlop]:" Canvas.Left="56" Canvas.Top="48"/>
        <ComboBox x:Name="sorSzamComboxBox" Canvas.Left="303" Canvas.Top="48" Height="26" Width="60"/>
        <ComboBox x:Name="oszlopSzamComboxBox" Canvas.Left="400" Canvas.Top="46" Height="28" Width="60" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button x:Name="letrehozButton" Content="Keresztrejtvény létrehozása" Canvas.Left="82" Canvas.Top="123" Height="32" Width="175" HorizontalAlignment="Center" VerticalAlignment="Top" Click="letrehozButton_Click"/>
        <Button x:Name="mentesButton" Content="Keresztrejtvény mentése" Canvas.Left="303" Canvas.Top="123" Height="32" Width="175" HorizontalAlignment="Center" VerticalAlignment="Top" Click="mentesButton_Click"/>

        <ComboBox x:Name="mentesIndexComboBox" Canvas.Left="528" Canvas.Top="123" Height="32" Width="49"/>
    </Canvas>

</Window>
